# Build artifacts
bin/
frontend/dist/
frontend/node_modules/

# Embedded SPA build output: only the .gitkeep marker is committed; real
# builds are never committed. go:embed is satisfied by the marker, and the
# server answers 503 with a hint when index.html is missing.
backend/internal/web/dist/*
!backend/internal/web/dist/.gitkeep

# TypeScript incremental build info
*.tsbuildinfo

# Runtime data
data/
*.db
*.db-wal
*.db-shm

# Local env
.env
.env.local

# OS / editor
.DS_Store
*.swp
