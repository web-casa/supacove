# Build artifacts
bin/
frontend/dist/
frontend/node_modules/

# Embedded SPA build output: only the .gitkeep marker is committed; real
# builds are never committed. go:embed is satisfied by the marker, and the
# server answers 503 with a hint when index.html is missing.
backend/internal/web/dist/*
!backend/internal/web/dist/.gitkeep

# TypeScript incremental build info
*.tsbuildinfo

# Runtime data
# (a stray pg_dump artifact named "-" once leaked into git; guard name)
backend/internal/jobs/-
data/
*.db
*.db-wal
*.db-shm

# Local env
.env
.env.local

# OS / editor
.DS_Store
*.swp

# playwright
frontend/test-results/
frontend/playwright-report/

# docs site build artifacts
docs-site/.next/
docs-site/node_modules/
docs-site/.source/
docs-site/next-env.d.ts
